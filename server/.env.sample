# Application Environment Mode (development | production | test)
NODE_ENV=production

# Server Port
PORT=8000

# CORS Allowed Origin
# Development: http://localhost:5173
# Production: https://events.example.com
CORS_ORIGIN=https://events.example.com

# PostgreSQL Database URL
# Development: postgresql://user:password@localhost:5433/event_management?schema=public
# Production: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public&sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5433/event_management?schema=public"

# Authentication & JWT Secrets (Generate each with: openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Password Hashing Work Factor (10 for dev/test, 12 recommended for production)
BCRYPT_ROUNDS=12

# Hold window in minutes for reserved tickets during checkout
PAYMENT_HOLD_MINUTES=15

# Payment Provider Mode ("test" for simulator, "live" for production)
PAYMENT_PROVIDER_MODE=live

# Webhook Secret for HMAC signature verification (Generate with: openssl rand -hex 32)
PAYMENT_WEBHOOK_SECRET=
